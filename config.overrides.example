# gnoland node config overrides (optional).
# Applied to gnoland-data/config/config.toml via 'gnoland config set' on each
# container start, BEFORE the system-hardcoded overrides listed below.
# Format: key = value (one per line; # for comments; blank lines ignored)

# ---- System-hardcoded keys (overridden by the entrypoint, cannot be customized)
# p2p.laddr                 = "tcp://0.0.0.0:26656"    # in-container P2P bind (see validator.env for host listener/port)
# rpc.laddr                 = "tcp://0.0.0.0:26657"    # in-container RPC bind (see validator.env for host listener/port)
# telemetry.metrics_enabled = true
# telemetry.traces_enabled  = true
# telemetry.exporter_endpoint = "http://sentinel:4318"

# ---- Optional external signer (tmkms or horcrux)
# Leave this whole block commented to use gnoland's built-in local file signer
# (the default). Uncomment ONE variant to delegate signing. The listen_addr
# scheme selects the mode; set listen_addr LAST (validation requires the other
# fields first). See README "Signing".
#
# Despite the name, tmkms_listener is not tmkms-only: it speaks the generic
# upstream Tendermint privval v0.34 protocol, and the signer dials gnoland. Any
# signer speaking it works — tmkms and horcrux both do.
#
# Local tmkms (bundled softsign container, dev/lab) — Unix socket:
#   'make start' runs a tmkms container that dials this socket. chain_id must
#   match; allowed_kms_pubkeys is ignored on unix sockets.
# consensus.priv_validator.tmkms_listener.chain_id         = "<chain-id>"
# consensus.priv_validator.tmkms_listener.protocol_version = "v0.34"
# consensus.priv_validator.tmkms_listener.listen_addr      = "unix:///tmkms-sock/privval.sock"
#
# Remote signer (external host, production) — TCP:
#   an operator-run signer on another host dials in. allowed_kms_pubkeys holds
#   the signer identity pubkey(s), comma-separated: ONE per tmkms instance, or
#   ONE per horcrux cosigner (leadership rotates, so every cosigner may hold the
#   connection). Required and non-empty — it is the only authorization control
#   on a tcp:// listener. Get the pubkeys from the signer operator; give them
#   the node identity that 'make gen-identity' prints.
#   Also set SIGNER_LISTEN_PORT in validator.env and firewall it to the signer IPs.
# consensus.priv_validator.tmkms_listener.chain_id            = "<chain-id>"
# consensus.priv_validator.tmkms_listener.protocol_version    = "v0.34"
# consensus.priv_validator.tmkms_listener.allowed_kms_pubkeys = "<pubkey1>,<pubkey2>,<pubkey3>"
# consensus.priv_validator.tmkms_listener.listen_addr         = "tcp://0.0.0.0:26659"
#
#   With horcrux, each cosigner also needs a persistent connKeyFile and
#   thresholdMode.leaderOnlyChainNodeConnections = true. See README "Signing".

# ---- Required node settings
moniker = "anon-val-01"
p2p.external_address = "<public-ip-or-domain>:26656"
p2p.persistent_peers = "<node-id>@<host>:26656,..."
telemetry.service_instance_id = "anon-val-01" # Node ID in Grafana
telemetry.service_name = "<chain-id-or-similar>" # Service ID in Grafana

# ---- Recommended settings for a validator node
application.prune_strategy = "syncable"
consensus.peer_gossip_sleep_duration = "10ms"
consensus.timeout_commit = "3s"
mempool.size = 10000
p2p.flush_throttle_timeout = "10ms"
p2p.max_num_outbound_peers = 40

# Test-only image: builds the gnogenesis CLI from a gno source ref. The e2e test
# uses it to synthesize a genesis.json containing the test validator. This is NOT
# part of the shipped validator images (operators provide their own genesis.json).
FROM    golang:1.25-alpine AS build
ARG     GNO_REPO=D4ryl00/gno
ARG     GNO_VERSION=master
RUN     apk add --no-cache git
RUN     git clone https://github.com/${GNO_REPO}.git /src && \
  git -C /src checkout ${GNO_VERSION}
# contribs/gnogenesis is its own nested Go module — build from inside it.
RUN     cd /src/contribs/gnogenesis && go build -o /usr/local/bin/gnogenesis .

FROM    alpine:3
COPY    --from=build /usr/local/bin/gnogenesis /usr/local/bin/gnogenesis
ENTRYPOINT ["gnogenesis"]

# ---- Where the gnoland binary comes from. Pick ONE of the two blocks below;
#      setting keys from both is refused, because the binary that ends up
#      running would depend on which code path resolved it first.

# 1. Build it here from gno source (the default).
#
# Optional — gno source version to build (branch, tag, or commit hash; default: master)
GNO_VERSION=master

# Optional — GitHub repo slug to clone gno sources from (default: gnolang/gno)
GNO_REPO=gnolang/gno

# 2. Or run a published image, and leave the build to upstream CI. Comment out
#    GNO_VERSION and GNO_REPO above before using this.
#
# Prefer an immutable ref — a sha-<short> tag or an @sha256: digest. A moving
# tag (chain-mainnet, latest) works, and the digest it resolved to at the last
# pull is recorded and reused, so a tag that moves between staging and restart
# cannot swap the binary underneath; but two nodes pulling it at different
# times can still end up on different code, which a pinned ref rules out.
#
# GNOLAND_IMAGE_REF=ghcr.io/gnolang/gno/gnoland:sha-00417a1

# Optional — sentinel image tag to pull from ghcr.io/aeddi/gno-watchtower/sentinel
# (default: latest). Pin to a specific tag or digest (e.g. sha256:abc123...) for
# reproducibility. When set to a tag like 'latest', make build/start/update
# check ghcr for a newer digest and report drift.
SENTINEL_IMAGE_TAG=latest

# Optional — host interface and port for gnoland RPC (defaults: 0.0.0.0, 26657)
# Use 127.0.0.1 to expose RPC only via a reverse proxy or keep it private.
GNOLAND_RPC_LADDR=0.0.0.0
GNOLAND_RPC_PORT=26657

# Optional — host interface and port for gnoland P2P (defaults: 0.0.0.0, 26656)
# Use 127.0.0.1 only if this node is not meant to accept inbound peer connections.
GNOLAND_P2P_LADDR=0.0.0.0
GNOLAND_P2P_PORT=26656

# Optional — host interface and port for the external signer's privval listener
# (defaults: 0.0.0.0, 26659). Only used when config.overrides enables a *remote*
# (tcp://) signer — tmkms or horcrux; the port is inert otherwise. Restrict the
# interface / firewall it to the signer host's IP in production. Signer mode
# itself is selected in config.overrides (unix:// = bundled local tmkms,
# tcp:// = remote signer), not here. The gnoland config key that drives it is
# still named tmkms_listener upstream — it speaks the generic Tendermint privval
# protocol, so tmkms and horcrux both connect to it.
SIGNER_LISTEN_LADDR=0.0.0.0
SIGNER_LISTEN_PORT=26659

# Optional — extra flags appended to `gnoland start` (word-split on whitespace).
# Default skips genesis-signature verification since operators typically supply
# their own trusted genesis.json. Remove or add flags as needed.
GNOLAND_EXTRA_FLAGS=--skip-genesis-sig-verification

# Optional — if set (to any non-empty value), syncs the system clock via NTP at startup (default: 1)
GNOLAND_NTP_UPDATE=1

# Optional — number of 1 GB gnoland log files to keep (default: 3)
GNOLAND_LOG_SIZE=
